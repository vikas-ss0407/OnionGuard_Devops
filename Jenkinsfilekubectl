pipeline {
    agent any

    parameters {
        string(
            name: 'BRANCH_NAME',
            defaultValue: 'main',
            description: 'GitHub Branch'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: false,
            description: 'Deploy Docker Containers and Kubernetes'
        )
    }

    environment {

        GITHUB_URL = 'https://github.com/vikas-ss0407/OnionGuard_Devops.git'

        FRONTEND_IMAGE = 'vikasss0407/onionguardfrontend'
        BACKEND_IMAGE  = 'vikasss0407/onionguardbackend'

        IMAGE_TAG = "${BUILD_NUMBER}"

        // Kubernetes kubeconfig copied inside Jenkins container
        KUBECONFIG = '/var/jenkins_home/.kube/minikube-config'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Clone Repository') {
            steps {
                git branch: params.BRANCH_NAME,
                    credentialsId: 'vikas_github_repo',
                    url: env.GITHUB_URL
            }
        }

        stage('Copy Backend .env') {
            steps {

                withCredentials([
                    file(
                        credentialsId: 'OnionGuard_Backend',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    sh '''
                    cp "$ENV_FILE" backend/.env
                    '''
                }
            }
        }

        stage('Build Frontend Image') {
            steps {

                dir('frontend') {

                    sh """
                    docker build \
                    -t ${FRONTEND_IMAGE}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Build Backend Image') {
            steps {

                dir('backend') {

                    sh """
                    docker build \
                    -t ${BACKEND_IMAGE}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Docker Login') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'Vikas_Docker',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                    echo "$DOCKER_PASSWORD" | docker login \
                    -u "$DOCKER_USERNAME" \
                    --password-stdin
                    '''
                }
            }
        }

        stage('Push Frontend Image') {
            steps {

                sh """
                docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:latest

                docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}

                docker push ${FRONTEND_IMAGE}:latest
                """
            }
        }

        stage('Push Backend Image') {
            steps {

                sh """
                docker tag ${BACKEND_IMAGE}:${IMAGE_TAG} ${BACKEND_IMAGE}:latest

                docker push ${BACKEND_IMAGE}:${IMAGE_TAG}

                docker push ${BACKEND_IMAGE}:latest
                """
            }
        }

        stage('Deploy Docker Containers') {

            when {
                expression {
                    return params.DEPLOY
                }
            }

            steps {

                sh '''

                echo "========================================"
                echo "DEPLOYING DOCKER CONTAINERS"
                echo "========================================"

                echo "Creating Docker Network..."

                docker network inspect onionguardnetwork >/dev/null 2>&1 || \
                docker network create onionguardnetwork

                echo "Removing Existing Containers..."

                docker rm -f onionguardfrontendcontainer || true
                docker rm -f onionguardbackendcontainer || true

                echo "Starting Backend Container..."

                docker run -d \
                --name onionguardbackendcontainer \
                --network onionguardnetwork \
                -p 5002:5000 \
                --env-file backend/.env \
                ${BACKEND_IMAGE}:${IMAGE_TAG}

                echo "Starting Frontend Container..."

                docker run -d \
                --name onionguardfrontendcontainer \
                --network onionguardnetwork \
                -p 5001:5173 \
                ${FRONTEND_IMAGE}:${IMAGE_TAG}

                echo "Docker Containers Started Successfully."

                '''

            }
        }

        stage('Check Kubernetes Connection') {

            when {
                expression {
                    return params.DEPLOY
                }
            }

            steps {

                sh '''

                set -e

                echo "========================================"
                echo "KUBERNETES CONNECTION CHECK"
                echo "========================================"

                echo ""
                echo "Kubeconfig:"
                echo "$KUBECONFIG"

                if [ ! -f "$KUBECONFIG" ]; then
                    echo "ERROR: Kubeconfig file not found!"
                    echo "Expected location: $KUBECONFIG"
                    exit 1
                fi

                echo ""
                echo "Current Kubernetes Context:"
                kubectl config current-context

                echo ""
                echo "Available Kubernetes Contexts:"
                kubectl config get-contexts

                echo ""
                echo "Kubernetes Nodes:"
                kubectl get nodes

                echo ""
                echo "Kubernetes Cluster Info:"
                kubectl cluster-info

                echo ""
                echo "Kubernetes connection successful!"

                echo "========================================"

                '''

            }
        }

        stage('Deploy to Kubernetes') {

            when {
                expression {
                    return params.DEPLOY
                }
            }

            steps {

                script {

                    try {

                        sh '''

                        set -e

                        echo "==============================="
                        echo "DEPLOYING TO KUBERNETES"
                        echo "==============================="

                        echo ""
                        echo "Applying Kubernetes manifests..."

                        kubectl apply -f kubernetes/

                        echo ""
                        echo "Updating Backend Image..."

                        kubectl set image deployment/onion-backend \
                        backend=${BACKEND_IMAGE}:${IMAGE_TAG}

                        echo ""
                        echo "Updating Frontend Image..."

                        kubectl set image deployment/onion-frontend \
                        frontend=${FRONTEND_IMAGE}:${IMAGE_TAG}

                        echo ""
                        echo "Checking Backend Rollout..."

                        kubectl rollout status deployment/onion-backend \
                        --timeout=300s

                        echo ""
                        echo "Checking Frontend Rollout..."

                        kubectl rollout status deployment/onion-frontend \
                        --timeout=300s

                        echo ""
                        echo "Checking Pods..."

                        kubectl get pods

                        echo ""
                        echo "Checking Services..."

                        kubectl get services

                        echo ""
                        echo "Deployment Successful!"

                        '''

                    } catch (err) {

                        echo "========================================"
                        echo "DEPLOYMENT FAILED!"
                        echo "Starting Automatic Rollback..."
                        echo "========================================"

                        sh '''

                        echo ""
                        echo "Rolling back Backend..."

                        kubectl rollout undo deployment/onion-backend || true

                        echo ""
                        echo "Rolling back Frontend..."

                        kubectl rollout undo deployment/onion-frontend || true

                        echo ""
                        echo "Waiting for Backend rollback..."

                        kubectl rollout status deployment/onion-backend \
                        --timeout=300s || true

                        echo ""
                        echo "Waiting for Frontend rollback..."

                        kubectl rollout status deployment/onion-frontend \
                        --timeout=300s || true

                        echo ""
                        echo "Current Pods:"

                        kubectl get pods || true

                        echo ""
                        echo "Rollback Completed."

                        '''

                        error("Deployment failed. Rollback attempted.")
                    }
                }
            }
        }
    }

    post {

        success {
            echo "Pipeline Completed Successfully."
        }

        failure {
            echo "Pipeline Failed."
        }

        always {
            sh 'docker logout || true'
        }
    }
}
